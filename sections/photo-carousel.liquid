{{ 'photo-carousel.css' | asset_url | stylesheet_tag }}

<section
  class="photo-carousel"
  id="photo-carousel-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  data-pause-on-hover="{% if section.settings.pause_on_hover %}true{% else %}false{% endif %}"
  data-slides-per-view="{{ section.settings.slides_per_view }}"
  style="
    --carousel-height: {{ section.settings.slide_height }}px;
    --slides-per-view: {{ section.settings.slides_per_view }};
    --carousel-bg: {{ section.settings.background_color }};
    --carousel-pt: {{ section.settings.padding_top }}px;
    --carousel-pr: {{ section.settings.padding_right }}px;
    --carousel-pb: {{ section.settings.padding_bottom }}px;
    --carousel-pl: {{ section.settings.padding_left }}px;
    --carousel-mt: {{ section.settings.margin_top }}px;
    --carousel-mb: {{ section.settings.margin_bottom }}px;
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="photo-carousel__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.blocks.size == 0 %}
    <p class="photo-carousel__empty">Agrega imagenes desde la configuracion de la seccion.</p>
  {% else %}
    <div class="photo-carousel__viewport">
      {% if section.settings.show_arrows %}
        <button type="button" class="photo-carousel__arrow photo-carousel__arrow--prev" data-carousel-prev aria-label="Anterior">
          &#10094;
        </button>
      {% endif %}

      <div class="photo-carousel__track" data-carousel-track>
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            {% assign slide_alt = block.settings.alt | default: block.settings.image.alt %}
            <div class="photo-carousel__slide" data-carousel-slide {{ block.shopify_attributes }}>
              {% capture slide_image %}
                {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: slide_alt, class: 'photo-carousel__image' }}
              {% endcapture %}
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="photo-carousel__link">
                  {{ slide_image }}
                </a>
              {% else %}
                {{ slide_image }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button type="button" class="photo-carousel__arrow photo-carousel__arrow--next" data-carousel-next aria-label="Siguiente">
          &#10095;
        </button>
      {% endif %}
    </div>

    {% if section.settings.show_dots %}
      <div class="photo-carousel__dots" data-carousel-dots></div>
    {% endif %}
  {% endif %}
</section>

<script src="{{ 'photo-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Carrusel de fotos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo"
    },
    {
      "type": "header",
      "content": "Espaciado y fondo"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding izquierdo",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding derecho",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin inferior",
      "default": 0
    },
    {
      "type": "header",
      "content": "Carrusel"
    },
    {
      "type": "range",
      "id": "slide_height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Altura del carrusel",
      "default": 420
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Imagenes visibles en escritorio",
      "default": 1
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Velocidad de transicion",
      "default": 4000
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar al pasar el cursor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar indicadores",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texto alternativo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace opcional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrusel de fotos",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}