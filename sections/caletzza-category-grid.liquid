{{ 'caletzza-theme.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .cz-category-grid {
    background: {{ section.settings.background_color }};
  }
{%- endstyle -%}

<div class="cz-category-grid section-{{ section.id }}-padding cz-category-grid--grid-3{% if section.settings.title_style == 'below' %} cz-category-grid--caption-below{% endif %}">
  <div class="page-width">
    {%- assign category_heading = section.settings.heading | strip -%}
    {%- if category_heading != blank -%}
      <h2 class="cz-category-grid__heading">{{ category_heading }}</h2>
    {%- endif -%}
    <ul class="cz-category-grid__list cz-category-grid__list--grid-3" role="list">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign item_title = block.settings.title | default: coll.title -%}
        <li class="cz-category-grid__item" {{ block.shopify_attributes }}>
          <a
            class="cz-category-grid__link"
            href="{{ block.settings.link | default: coll.url | default: '#' }}"
          >
            <span class="cz-category-grid__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: class: 'cz-category-grid__image', loading: 'lazy', alt: item_title
                }}
              {%- elsif coll.featured_image -%}
                {{
                  coll.featured_image
                  | image_url: width: 800
                  | image_tag: class: 'cz-category-grid__image', loading: 'lazy', alt: coll.title
                }}
              {%- else -%}
                <span class="cz-category-grid__placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </span>
            {%- if section.settings.title_style == 'overlay' -%}
              <span class="cz-category-grid__overlay">
                <span class="cz-category-grid__title">{{ item_title | escape }}</span>
              </span>
            {%- else -%}
              <span class="cz-category-grid__title">{{ item_title | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Grid categorías Caletzza",
  "tag": "section",
  "class": "section-caletzza-category-grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Opcional. Déjalo vacío para ocultarlo en el Home."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#FDF5EB"
    },
    {
      "type": "paragraph",
      "content": "Home: siempre 3 columnas fijas (fila 1: Bodys, Básicas, Blusas; fila 2: las otras tres). Sin slider."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño",
      "options": [
        { "value": "grid-3", "label": "3 columnas fijas (recomendado)" },
        { "value": "grid", "label": "Cuadrícula (igual 3 columnas en Home)" }
      ],
      "default": "grid-3"
    },    {
      "type": "select",
      "id": "title_style",
      "label": "Estilo del título",
      "options": [
        { "value": "below", "label": "Debajo de la imagen" },
        { "value": "overlay", "label": "Sobre la imagen" }
      ],
      "default": "below"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Colección",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoría",
          "info": "Si está vacío, usa el nombre de la colección."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace alternativo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada",
          "info": "Si está vacía, usa la imagen de la colección."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid categorías Caletzza",
      "blocks": [
        { "type": "category", "settings": { "title": "BODYS" } },
        { "type": "category", "settings": { "title": "BASICAS" } },
        { "type": "category", "settings": { "title": "BLUSAS" } },
        { "type": "category", "settings": { "title": "PIJAMAS" } },
        { "type": "category", "settings": { "title": "OVERSIZES" } },
        { "type": "category", "settings": { "title": "CAMISETAS HOMBRES" } }
      ]
    }
  ]
}
{% endschema %}
