{% schema %}
{
  "name": "Product Selection Grid",
  "settings": [],
  "presets": [
    {
      "name": "Product Selection Grid (Dynamic)",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="page-width">
  <div id="product-selection-grid">
    {% for i in (1..10) %}
      <div class="product-slot" data-index="{{ i }}">
        <span class="add-product">+</span>
        <img loading="lazy" class="selected-product-img" src="" alt="" style="display:none;">
        <p class="selected-product-title" style="display:none;"></p>
        <select class="selected-variant" style="display:none;"></select>
      </div>
    {% endfor %}
  </div>
  
  <div class="global-quantity-control" style="display:none; margin:20px 0; text-align:center;">
    <div style="display:none; align-items:center; gap:10px;">
      <label style="font-weight:bold;">Cantidad:</label>
      <div style="display:flex; align-items:center; border:1px solid #ddd; border-radius:4px;">
        <button type="button" id="decrease-quantity" style="width:40px; height:40px;">-</button>
        <input type="number" id="global-quantity" value="1" min="1" style="width:60px; text-align:center;">
        <button type="button" id="increase-quantity" style="width:40px; height:40px;">+</button>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
    <button type="button" id="buy-now-btn" disabled>Comprar ahora</button>
    <button type="button" id="clear-all-btn" style="background: #f44336; color: white;">Borrar todo</button>
  </div>
</div>

<div id="product-popup" class="popup-overlay" style="display:none;">
  <div class="popup-content">
    <span class="close-popup">X</span>
    <div id="product-list"></div>
    <div id="pagination-controls">
      <button type="button" id="prev-page" disabled>Anterior</button>
      <span id="page-info">Página <span id="current-page">1</span></span>
      <button type="button" id="next-page">Siguiente</button>
    </div>
  </div>
</div>

<style>
        #product-selection-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 10px;
      }
      .product-slot {
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
        background: #f8f8f8;
        border-radius: 4px;
        aspect-ratio: 1/1;
      }
      @media screen and (min-width: 769px) {
        .product-slot { height: 200px; }
        .add-product { font-size: 24px; }
      }
      @media screen and (max-width: 768px) {
        .product-slot { height: 180px; width: 64px; }
        .add-product { font-size: 18px; }
        p.selected-product-title {font-size: 10px;}
      }
      .add-product { color: #666; font-weight: bold; }
      .selected-product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
      }
      .popup-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        align-items: center;
        justify-content: center;
        z-index: 1000;
      }
      #product-popup .popup-content {
        background: white;
        width: 90%;
        max-width: 800px;
        height: 80vh;
        padding: 20px;
        position: relative;
        overflow-y: auto;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        border-radius: 8px;
      }
      .close-popup {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 20px;
        cursor: pointer;
        background: #000;
        padding: 2px 10px;
        color: #fff;
        font-weight: 900;
        border-radius: 6px;
        z-index: 1;
      }
      #product-list {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: center;
      }
      .product-item {
        text-align: center;
        cursor: pointer;
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 5px;
        width: 150px;
        overflow: hidden;
        transition: transform 0.2s;
      }
      .product-item:hover { transform: scale(1.05); }
      .product-image {
        width: 100%;
        height: 150px;
        object-fit: cover;
        cursor: pointer;
        margin-bottom: 10px;
      }
      .variant-selector {
        width: 100%;
        max-width: 100%;
        white-space: normal;
        word-wrap: break-word;
        font-size: 12px;
        padding: 5px;
        margin-top: 5px;
        box-sizing: border-box;
        display: none;
      }
      .variant-selector option {
        white-space: normal;
        word-break: break-word;
        padding: 5px;
      }
      #global-quantity::-webkit-outer-spin-button,
      #global-quantity::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
      #global-quantity { -moz-appearance: textfield; }
      .popup-box {
        background: white;
        padding: 30px;
        text-align: center;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        width: 90%;
        max-width: 400px;
      }
      .popup-box button {
        margin: 10px;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
        font-weight: bold;
        border-radius: 4px;
      }
      #accept-offer { background: green; color: white; }
      #decline-offer { background: red; color: white; }
      #buy-now-btn {
        background: green;
        color: #fff;
        padding: 12px 20px;
        font-size: 16px;
        cursor: pointer;
        border: none;
        border-radius: 4px;
        width: 100%;
        max-width: 300px;
      }
      #buy-now-btn:disabled { opacity: 0.6; cursor: not-allowed; }
      #pagination-controls {
        text-align: center;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 15px;
      }
      #pagination-controls button {
        background: #000;
        color: #fff;
        padding: 5px 20px;
        font-weight: 700;
        border: 0px;
        border-radius: 4px;
        cursor: pointer;
      }
      #pagination-controls button:disabled { opacity: 0.5; cursor: not-allowed; }
      #page-info { font-weight: 600; }
      #clear-all-btn:hover {
        background: #d32f2f !important;
      }
  #product-selection-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    padding-bottom: 10px;
  }
  .product-slot {
    border: 2px dashed #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    background: #f8f8f8;
    border-radius: 4px;
    aspect-ratio: 1/1;
  }
  .add-product { font-size: 24px; font-weight: bold; color: #666; }
  .selected-product-img {
    width: 100%; height: 100%; object-fit: cover;
    position: absolute; top: 0; left: 0;
  }
  .popup-overlay {
    display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.7); align-items: center; justify-content: center; z-index: 1000;
  }
  .popup-content {
    background: white; width: 90%; max-width: 800px; height: 80vh; padding: 20px;
    position: relative; overflow-y: auto; border-radius: 8px;
  }
  .close-popup {
    position: absolute; top: 10px; right: 10px; font-size: 20px;
    cursor: pointer; background: #000; color: #fff; border-radius: 6px; padding: 5px 10px;
  }
  #product-list {
    display: flex; flex-wrap: wrap; gap: 15px; justify-content: center;
  }
  .product-item {
    text-align: center; border: 1px solid #ddd; padding: 10px; border-radius: 5px; width: 160px;
    cursor: pointer;
  }
  .product-item img {
    width: 100%; height: 160px; object-fit: cover; border-radius: 4px;
  }

  body.modal-open {
  overflow: hidden;
  position: fixed;
  width: 100%;
}
</style>

<script>
const accessToken = '2cbb41e2000dff3ceaa606f7e3a61755';
const endpoint = '/api/2023-07/graphql.json';

let allProducts = [];
let paginatedProducts = [];
let scrollY = 0;
const PRODUCTS_PER_PAGE = 50;

const productList = document.getElementById('product-list');
const currentPageSpan = document.getElementById('current-page');
const productSlots = document.querySelectorAll('.product-slot');
const globalQuantityControl = document.querySelector('.global-quantity-control');
const buyNowBtn = document.getElementById('buy-now-btn');
const clearAllBtn = document.getElementById('clear-all-btn');
const productPopup = document.getElementById('product-popup');

let selectedSlot = null;
let selectedProducts = [];
let currentPageIndex = 0;

async function fetchAllProducts() {
  let cursor = null;
  let hasNextPage = true;

  while (hasNextPage) {
    const query = `
      query getAllProducts($cursor: String) {
        products(first: 100, after: $cursor) {
          pageInfo {
            hasNextPage
          }
          edges {
            cursor
            node {
              id
              title
              handle
              featuredImage { url }
              variants(first: 100) {
                edges {
                  node {
                    id
                    title
                    price { amount currencyCode }
                    image { url }
                  }
                }
              }
            }
          }
        }
      }
    `;

    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': accessToken
      },
      body: JSON.stringify({ query, variables: { cursor } })
    });

    const { data } = await response.json();
    const products = data.products;
    allProducts.push(...products.edges.map(edge => edge.node));
    hasNextPage = products.pageInfo.hasNextPage;
    cursor = products.edges.at(-1)?.cursor;
  }

  sortAndPaginateProducts();
  renderProducts(paginatedProducts[currentPageIndex]);
}

function sortAndPaginateProducts() {
  // Puedes ordenar si deseas, o dejar el orden original
  // allProducts.sort((a, b) => a.title.localeCompare(b.title));

  const totalPages = Math.ceil(allProducts.length / PRODUCTS_PER_PAGE);
  paginatedProducts = Array.from({ length: totalPages }, (_, i) =>
    allProducts.slice(i * PRODUCTS_PER_PAGE, (i + 1) * PRODUCTS_PER_PAGE)
  );
}

function optimizeImageUrl(url) {
  return url?.replace(/(\.jpg|\.png|\.jpeg)(\?.*)?$/, '_compact$1');
}

function renderProducts(products) {
  const fragment = document.createDocumentFragment();
  productList.innerHTML = '';

  products.forEach(product => {
    const allVariants = product.variants.edges;
    if (allVariants.length === 0) return;

    const div = document.createElement('div');
    div.className = 'product-item';
    div.dataset.id = product.id;

    const imageUrl = optimizeImageUrl(product.featuredImage?.url || '');
    const title = product.title;

    const select = document.createElement('select');
    select.className = 'variant-selector';

    allVariants.forEach(v => {
      const opt = document.createElement('option');
      const variantImg = v.node.image?.url || imageUrl;
      opt.value = v.node.id;
      opt.dataset.image = variantImg;
      opt.textContent = `${v.node.title} - ${v.node.price.amount} ${v.node.price.currencyCode}`;
      select.appendChild(opt);
    });

    div.innerHTML = `<img loading="lazy" src="${imageUrl}" alt="${title}"><p>${title}</p>`;
    div.appendChild(select);

    fragment.appendChild(div);
  });

  productList.appendChild(fragment);
  currentPageSpan.textContent = currentPageIndex + 1;
  document.getElementById('next-page').disabled = currentPageIndex >= paginatedProducts.length - 1;
  document.getElementById('prev-page').disabled = currentPageIndex <= 0;
}

function openPopup(slot) {
  selectedSlot = slot;
  scrollY = window.scrollY;
  document.querySelector('.popup-overlay').style.display = 'flex';
  document.body.style.position = 'fixed';
  document.body.style.top = `-${scrollY}px`;
  document.body.style.left = '0';
  document.body.style.right = '0';
  document.body.style.overflow = 'hidden';
  document.body.style.width = '100%';
}

function closePopup() {
  document.querySelector('.popup-overlay').style.display = 'none';
  document.body.style.position = '';
  document.body.style.top = '';
  document.body.style.left = '';
  document.body.style.right = '';
  document.body.style.overflow = '';
  document.body.style.width = '';
  selectedSlot = null;
  window.scrollTo(0, scrollY);
}

function updateUIAfterSelection() {
  const selectedCount = selectedProducts.filter(p => p).length;
  globalQuantityControl.style.display = selectedCount > 0 ? 'block' : 'none';
  buyNowBtn.disabled = selectedCount !== 10;
  closePopup();
}

// Event delegation for product selection
productList.addEventListener('click', e => {
  e.preventDefault(); // ⬅️ Aquí lo ponemos primero
  e.stopPropagation(); // ⬅️ También útil para detener bubbling
  
  const productDiv = e.target.closest('.product-item');
  if (!productDiv || !selectedSlot) return;

  const select = productDiv.querySelector('.variant-selector');
  const variantId = select.value;
  const variantText = select.selectedOptions[0].textContent;
  const variantImg = select.selectedOptions[0].dataset.image;
  const title = productDiv.querySelector('p').textContent;
  const index = selectedSlot.dataset.index;

  selectedSlot.innerHTML = `
    <img class="selected-product-img" src="${variantImg}" alt="${title}">
    <p class="selected-product-title">${title} - ${variantText}</p>
  `;
  selectedProducts[index] = { variantId };
  updateUIAfterSelection();
  closePopup();
});

document.getElementById('next-page').addEventListener('click', () => {
  if (currentPageIndex < paginatedProducts.length - 1) {
    currentPageIndex++;
    renderProducts(paginatedProducts[currentPageIndex]);
  }
});

document.getElementById('prev-page').addEventListener('click', () => {
  if (currentPageIndex > 0) {
    currentPageIndex--;
    renderProducts(paginatedProducts[currentPageIndex]);
  }
});

document.querySelector('.close-popup').addEventListener('click', closePopup);

productSlots.forEach(slot => {
  slot.addEventListener('click', () => openPopup(slot));
});

document.getElementById('increase-quantity').addEventListener('click', () => {
  const input = document.getElementById('global-quantity');
  input.value = parseInt(input.value) + 1;
});

document.getElementById('decrease-quantity').addEventListener('click', () => {
  const input = document.getElementById('global-quantity');
  if (parseInt(input.value) > 1) {
    input.value = parseInt(input.value) - 1;
  }
});

      buyNowBtn.addEventListener('click', () => {
  const quantity = parseInt(document.getElementById('global-quantity').value);
  const items = selectedProducts
    .filter(p => p)
    .map(p => `${p.variantId.split('/').pop()}:${quantity}`)
    .join(',');

  if (items) {
    window.location.href = `/cart/${items}`;
  } else {
    alert('Selecciona al menos un producto.');
  }
});


// Load products on start
fetchAllProducts();

</script>
