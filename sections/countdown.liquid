{% comment %}
  Countdown Timer Section
{% endcomment %}

<div class="countdown-container">
  <h2>¡La promoción termina en!</h2>
  <div id="countdown" class="countdown">
    <div><span id="days">00</span><small>Días</small></div>
    <div><span id="hours">00</span><small>Horas</small></div>
    <div><span id="minutes">00</span><small>Minutos</small></div>
    <div><span id="seconds">00</span><small>Segundos</small></div>
  </div>
</div>

<style>
  .countdown-container {
    text-align: center;
    font-family: sans-serif;
    background: #f4f4f4;
    padding: 20px;
    border-radius: 12px;
    max-width: 400px;
    margin: 40px auto;
  }

  .countdown {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 10px;
  }

  .countdown div {
    background: white;
    padding: 10px;
    border-radius: 10px;
    min-width: 60px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .countdown span {
    display: block;
    font-size: 24px;
    font-weight: bold;
  }

  .countdown small {
    display: block;
    font-size: 12px;
    color: #555;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const targetDate = new Date('{{ section.settings.countdown_date }}');

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = targetDate.getTime() - now;

      if (distance < 0) {
        document.getElementById('countdown').innerHTML = '<p>¡La promoción ha terminado!</p>';
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      document.getElementById('days').textContent = String(days).padStart(2, '0');
      document.getElementById('hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  });
</script>

{% schema %}
{
  "name": "Contador regresivo",
  "settings": [
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Fecha objetivo (formato ISO: YYYY-MM-DDTHH:MM:SSZ)",
      "default": "2025-05-01T23:59:59Z",
      "info": "Ejemplo: 2025-05-01T23:59:59Z (hora UTC)"
    }
  ],
  "presets": [
    {
      "name": "Contador regresivo"
    }
  ]
}
{% endschema %}
