      "settings": {
        "custom_liquid": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\">\n\n<style>\n  .cz-vl { background:#fdf5eb; color:#878787; padding:48px 16px; width:100%; box-sizing:border-box; touch-action:pan-y; }\n  .cz-vl__wrap { max-width:920px; margin:0 auto; position:relative; }\n  .cz-vl__viewport { overflow:hidden; width:100%; cursor:grab; }\n  .cz-vl__viewport.is-dragging { cursor:grabbing; }\n  .cz-vl__track {\n    display:flex;\n    width:200%;\n    transition:transform .35s ease;\n    will-change:transform;\n  }\n  .cz-vl__track.is-dragging { transition:none; }\n  .cz-vl__slide {\n    width:50%;\n    flex:0 0 50%;\n    box-sizing:border-box;\n  }\n  .cz-vl__grid {\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:1.2rem 2rem;\n  }\n  .cz-vl__item {\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    text-align:center;\n    padding:.4rem .8rem;\n  }\n  .cz-vl__icon {\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:4.8rem;\n    height:4rem;\n    margin:0 auto 1.1rem;\n    color:#502f1d;\n    font-size:2.6rem;\n    line-height:1;\n  }\n  .cz-vl__addi {\n    font-family:\"Avenir Next\", Montserrat, \"Helvetica Neue\", sans-serif;\n    font-weight:800;\n    font-size:2.8rem;\n    line-height:1;\n    letter-spacing:-.03em;\n    color:#1f7ae0;\n    font-style:italic;\n  }\n  .cz-vl__text {\n    margin:0;\n    max-width:28rem;\n    font-size:clamp(.95rem,1.5vw,1.15rem);\n    font-weight:500;\n    letter-spacing:.04em;\n    line-height:1.45;\n    text-transform:uppercase;\n  }\n  .cz-vl__dots {\n    display:flex;\n    justify-content:center;\n    gap:10px;\n    margin-top:1.6rem;\n  }\n  .cz-vl__dot {\n    width:9px;\n    height:9px;\n    border:0;\n    padding:0;\n    border-radius:50%;\n    background:rgba(80,47,29,.28);\n    cursor:pointer;\n  }\n  .cz-vl__dot.is-active {\n    background:#502f1d;\n    transform:scale(1.12);\n  }\n  @media (max-width:749px) {\n    .cz-vl { padding:36px 12px; }\n    .cz-vl__grid { gap:1rem 1.2rem; }\n    .cz-vl__icon { width:3.6rem; height:3.2rem; margin-bottom:.85rem; font-size:2rem; }\n    .cz-vl__addi { font-size:2.1rem; }\n    .cz-vl__text { font-size:.78rem; }\n  }\n</style>\n\n<div class=\"cz-vl\" id=\"cz-vl\">\n  <div class=\"cz-vl__wrap\">\n    <div class=\"cz-vl__viewport\" data-viewport>\n      <div class=\"cz-vl__track\" data-track>\n        <div class=\"cz-vl__slide\">\n          <div class=\"cz-vl__grid\">\n            <div class=\"cz-vl__item\">\n              <div class=\"cz-vl__icon\"><span class=\"cz-vl__addi\">Addi</span></div>\n              <p class=\"cz-vl__text\">COMPRA HOY, PAGA DESPUÉS</p>\n            </div>\n            <div class=\"cz-vl__item\">\n              <div class=\"cz-vl__icon\"><i class=\"fa-solid fa-scissors\"></i></div>\n              <p class=\"cz-vl__text\">HECHO POR MANOS<br>COLOMBIANAS</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"cz-vl__slide\">\n          <div class=\"cz-vl__grid\">\n            <div class=\"cz-vl__item\">\n              <div class=\"cz-vl__icon\"><i class=\"fa-solid fa-shirt\"></i></div>\n              <p class=\"cz-vl__text\">SENTIRTE LINDA Y CÓMODA A<br>UN PRECIO JUSTO NUNCA<br>HABÍA SIDO TAN FÁCIL.</p>\n            </div>\n            <div class=\"cz-vl__item\">\n              <div class=\"cz-vl__icon\"><i class=\"fa-solid fa-wand-magic-sparkles\"></i></div>\n              <p class=\"cz-vl__text\">BRILLA DESDE TU INTERIOR</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cz-vl__dots\">\n      <button type=\"button\" class=\"cz-vl__dot is-active\" data-dot=\"0\" aria-label=\"Diapositiva 1\"></button>\n      <button type=\"button\" class=\"cz-vl__dot\" data-dot=\"1\" aria-label=\"Diapositiva 2\"></button>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById('cz-vl');\n  if (!root) return;\n\n  var viewport = root.querySelector('[data-viewport]');\n  var track = root.querySelector('[data-track]');\n  var dots = root.querySelectorAll('[data-dot]');\n  var total = 2;\n  var current = 0;\n  var timer = null;\n  var startX = 0;\n  var deltaX = 0;\n  var dragging = false;\n\n  function goTo(index) {\n    current = ((index % total) + total) % total;\n    track.style.transform = 'translateX(-' + (current * 50) + '%)';\n    dots.forEach(function (dot, i) {\n      dot.classList.toggle('is-active', i === current);\n    });\n  }\n\n  function next() { goTo(current + 1); }\n  function prev() { goTo(current - 1); }\n\n  function startAutoplay() {\n    clearInterval(timer);\n    timer = setInterval(next, 5000);\n  }\n\n  dots.forEach(function (dot) {\n    dot.addEventListener('click', function () {\n      goTo(Number(dot.getAttribute('data-dot') || 0));\n      startAutoplay();\n    });\n  });\n\n  function onStart(x) {\n    dragging = true;\n    startX = x;\n    deltaX = 0;\n    track.classList.add('is-dragging');\n    viewport.classList.add('is-dragging');\n    clearInterval(timer);\n  }\n\n  function onMove(x) {\n    if (!dragging) return;\n    deltaX = x - startX;\n    var base = -(current * 50);\n    var pct = (deltaX / viewport.offsetWidth) * 50;\n    track.style.transform = 'translateX(' + (base + pct) + '%)';\n  }\n\n  function onEnd() {\n    if (!dragging) return;\n    dragging = false;\n    track.classList.remove('is-dragging');\n    viewport.classList.remove('is-dragging');\n    if (Math.abs(deltaX) > 40) {\n      if (deltaX < 0) next();\n      else prev();\n    } else {\n      goTo(current);\n    }\n    startAutoplay();\n  }\n\n  viewport.addEventListener('touchstart', function (e) {\n    if (!e.touches[0]) return;\n    onStart(e.touches[0].clientX);\n  }, { passive: true });\n\n  viewport.addEventListener('touchmove', function (e) {\n    if (!e.touches[0]) return;\n    onMove(e.touches[0].clientX);\n  }, { passive: true });\n\n  viewport.addEventListener('touchend', onEnd, { passive: true });\n  viewport.addEventListener('touchcancel', onEnd, { passive: true });\n\n  viewport.addEventListener('mousedown', function (e) {\n    e.preventDefault();\n    onStart(e.clientX);\n  });\n  window.addEventListener('mousemove', function (e) {\n    if (!dragging) return;\n    onMove(e.clientX);\n  });\n  window.addEventListener('mouseup', onEnd);\n\n  goTo(0);\n  startAutoplay();\n})();\n</script>",
