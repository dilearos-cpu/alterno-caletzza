{% comment %}
  Modal checkout express estilo EasySell COD Form.
{% endcomment %}
<div
  class="pack-cod"
  data-pack-cod
  hidden
  style="
    --pack-cod-accent: {{ section.settings.cod_accent_color | default: '#1fad66' }};
    --pack-cod-accent-dark: {{ section.settings.cod_accent_color | default: '#1fad66' | color_darken: 8 }};
  "
>
  <div class="pack-cod__dialog" data-cod-dialog role="dialog" aria-modal="true" aria-label="{{ section.settings.cod_form_title | escape }}">
    <button type="button" class="pack-cod__close" data-cod-close aria-label="Cerrar">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <div class="pack-cod__main" data-cod-main>
      <header class="pack-cod__header">
        <h3 class="pack-cod__title">{{ section.settings.cod_form_title }}</h3>
        <p class="pack-cod__subtitle">{{ section.settings.cod_form_subtitle }}</p>
      </header>

      <div class="pack-cod__grid">
        <div class="pack-cod__summary">
          <p class="pack-cod__summary-label">Tu pedido</p>
          <ul class="pack-cod__items" data-cod-items></ul>
          <dl class="pack-cod__totals">
            <div class="pack-cod__total-row pack-cod__total-row--discount" data-cod-discount-row hidden>
              <dt>Descuento por cantidad</dt>
              <dd data-cod-discount>-$0</dd>
            </div>
            <div class="pack-cod__total-row pack-cod__total-row--shipping">
              <dt>Envio</dt>
              <dd data-cod-shipping>$0</dd>
            </div>
            <div class="pack-cod__total-row pack-cod__total-row--grand">
              <dt>Total</dt>
              <dd data-cod-total>$0</dd>
            </div>
          </dl>
        </div>

        <form class="pack-cod__form" data-cod-form novalidate>
          {% if section.settings.cod_enable_online_payment %}
            <fieldset class="pack-cod__payments" data-cod-payments>
              <legend class="pack-cod__payments-title">Metodo de pago</legend>
              <div class="pack-cod__payments-grid">
                <label class="pack-cod__pay-card pack-cod__pay-card--active">
                  <input type="radio" name="payment_method" value="cod" checked>
                  <span class="pack-cod__pay-card-inner">
                    <span class="pack-cod__pay-icon pack-cod__pay-icon--cod" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 3C7.58 3 4 6.58 4 11v2H3a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1h-1v-2c0-4.42-3.58-8-8-8Zm-6 9v-1c0-3.31 2.69-6 6-6s6 2.69 6 6v1H6Zm6 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/></svg>
                    </span>
                    <span class="pack-cod__pay-text">
                      <strong>{{ section.settings.cod_payment_cod_title }}</strong>
                      <small>{{ section.settings.cod_payment_cod_hint }}</small>
                    </span>
                  </span>
                </label>
                <label class="pack-cod__pay-card">
                  <input type="radio" name="payment_method" value="online">
                  <span class="pack-cod__pay-card-inner">
                    <span class="pack-cod__pay-icon pack-cod__pay-icon--online" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
                    </span>
                    <span class="pack-cod__pay-text">
                      <strong>{{ section.settings.cod_payment_online_title }}</strong>
                      <small>{{ section.settings.cod_payment_online_hint }}</small>
                    </span>
                  </span>
                </label>
              </div>
            </fieldset>
          {% endif %}

          <p class="pack-cod__payment-note" data-cod-payment-note>{{ section.settings.cod_payment_note }}</p>

          <div class="pack-cod__fields">
            <div class="pack-cod__field">
              <label for="pack-cod-name-{{ section.id }}">Nombre completo *</label>
              <div class="pack-cod__input-wrap">
                <span class="pack-cod__field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z"/></svg>
                </span>
                <input id="pack-cod-name-{{ section.id }}" name="full_name" type="text" autocomplete="name" placeholder="Tu nombre" required>
              </div>
            </div>
            <div class="pack-cod__field">
              <label for="pack-cod-phone-{{ section.id }}">WhatsApp / Telefono *</label>
              <div class="pack-cod__input-wrap">
                <span class="pack-cod__field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 .89 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1Z"/></svg>
                </span>
                <input id="pack-cod-phone-{{ section.id }}" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="300 123 4567" required>
              </div>
            </div>
            <div class="pack-cod__field">
              <label for="pack-cod-email-{{ section.id }}">Correo (opcional)</label>
              <div class="pack-cod__input-wrap">
                <span class="pack-cod__field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
                </span>
                <input id="pack-cod-email-{{ section.id }}" name="email" type="email" autocomplete="email" placeholder="correo@ejemplo.com">
              </div>
            </div>
            <div class="pack-cod__field-row">
              <div class="pack-cod__field">
                <label for="pack-cod-city-{{ section.id }}">Ciudad *</label>
                <input id="pack-cod-city-{{ section.id }}" name="city" type="text" autocomplete="address-level2" placeholder="Ciudad" required>
              </div>
              <div class="pack-cod__field">
                <label for="pack-cod-province-{{ section.id }}">Departamento *</label>
                <select id="pack-cod-province-{{ section.id }}" name="province" required>
                  <option value="">Selecciona...</option>
                  <option value="Amazonas">Amazonas</option>
                  <option value="Antioquia">Antioquia</option>
                  <option value="Arauca">Arauca</option>
                  <option value="Atlantico">Atlantico</option>
                  <option value="Bogota D.C.">Bogota D.C.</option>
                  <option value="Bolivar">Bolivar</option>
                  <option value="Boyaca">Boyaca</option>
                  <option value="Caldas">Caldas</option>
                  <option value="Caqueta">Caqueta</option>
                  <option value="Casanare">Casanare</option>
                  <option value="Cauca">Cauca</option>
                  <option value="Cesar">Cesar</option>
                  <option value="Choco">Choco</option>
                  <option value="Cordoba">Cordoba</option>
                  <option value="Cundinamarca">Cundinamarca</option>
                  <option value="Guainia">Guainia</option>
                  <option value="Guaviare">Guaviare</option>
                  <option value="Huila">Huila</option>
                  <option value="La Guajira">La Guajira</option>
                  <option value="Magdalena">Magdalena</option>
                  <option value="Meta">Meta</option>
                  <option value="Narino">Narino</option>
                  <option value="Norte de Santander">Norte de Santander</option>
                  <option value="Putumayo">Putumayo</option>
                  <option value="Quindio">Quindio</option>
                  <option value="Risaralda">Risaralda</option>
                  <option value="San Andres">San Andres</option>
                  <option value="Santander">Santander</option>
                  <option value="Sucre">Sucre</option>
                  <option value="Tolima">Tolima</option>
                  <option value="Valle del Cauca">Valle del Cauca</option>
                  <option value="Vaupes">Vaupes</option>
                  <option value="Vichada">Vichada</option>
                </select>
              </div>
            </div>
            <div class="pack-cod__field">
              <label for="pack-cod-address-{{ section.id }}">Direccion *</label>
              <div class="pack-cod__input-wrap">
                <span class="pack-cod__field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5Z"/></svg>
                </span>
                <input id="pack-cod-address-{{ section.id }}" name="address1" type="text" autocomplete="street-address" placeholder="Calle, numero, apartamento" required>
              </div>
            </div>
            <div class="pack-cod__field">
              <label for="pack-cod-notes-{{ section.id }}">Barrio / Referencia</label>
              <textarea id="pack-cod-notes-{{ section.id }}" name="note" rows="2" placeholder="Indicaciones para la entrega"></textarea>
            </div>
          </div>

          <p class="pack-cod__error" data-cod-error hidden></p>
          <button type="submit" class="pack-cod__submit" data-cod-submit>
            {{ section.settings.cod_submit_label }}
          </button>
          {% if section.settings.cod_show_checkout_fallback %}
            <button type="button" class="pack-cod__fallback" data-cod-fallback hidden>
              Continuar al checkout de Shopify
            </button>
          {% endif %}
        </form>
      </div>
    </div>

    <div class="pack-cod__success" data-cod-success hidden>
      <div class="pack-cod__success-inner">
        <div class="pack-cod__success-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="36" height="36"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
        </div>
        <h3 class="pack-cod__success-title">{{ section.settings.cod_success_title }}</h3>
        <p class="pack-cod__success-text" data-cod-success-text>{{ section.settings.cod_success_message }}</p>
        <p class="pack-cod__order-name" data-cod-order-name></p>
        <button type="button" class="pack-cod__submit pack-cod__done" data-cod-done>Listo</button>
      </div>
    </div>
  </div>
</div>
