<div class="cz-qb-modal" data-cz-qb-modal hidden>
  <div class="cz-qb-modal__overlay" data-cz-qb-close></div>
  <div
    class="cz-qb-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CzQuickBuyLabel"
    tabindex="-1"
  >
    <span id="CzQuickBuyLabel" class="visually-hidden">Compra rápida</span>
    <button type="button" class="cz-qb-modal__close" data-cz-qb-close aria-label="Cerrar">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <div class="cz-qb-modal__body">
      <div class="cz-qb-modal__group" data-cz-qb-color-group hidden>
        <p class="cz-qb-modal__label" data-cz-qb-color-label>Color</p>
        <div class="cz-qb-modal__swatches" data-cz-qb-colors></div>
      </div>
      <div class="cz-qb-modal__group" data-cz-qb-size-group hidden>
        <p class="cz-qb-modal__label" data-cz-qb-size-label>Talla</p>
        <div class="cz-qb-modal__sizes" data-cz-qb-sizes></div>
      </div>
      <p class="cz-qb-modal__error" data-cz-qb-error hidden></p>
      <button type="button" class="cz-qb-modal__submit" data-cz-qb-submit>
        Agregar al carrito
      </button>
    </div>
  </div>
</div>
