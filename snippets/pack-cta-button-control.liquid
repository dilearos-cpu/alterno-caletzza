{% comment %}
  Renders the CTA button control.
  Accepts:
  - is_link: {Boolean}
  - button_action: {String}
  - button_link: {String}
  - open_in_new_tab: {Boolean}
  - button_label: {String}
  - show_icon: {Boolean}
  - icon_image: {Image}
  - icon_preset: {String}
  - extra_class: {String}
  - extra_attributes: {String}
{% endcomment %}

{% if is_link %}
  <a
    href="{{ button_link }}"
    class="pack-cta__button {{ extra_class }}"
    data-cta-button
    data-cta-action="link"
    {{ extra_attributes }}
    {% if open_in_new_tab %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  >
{% else %}
  <button
    type="button"
    class="pack-cta__button {{ extra_class }}"
    data-cta-button
    data-cta-action="{{ button_action }}"
    {{ extra_attributes }}
  >
{% endif %}
  <span class="pack-cta__label">{{ button_label }}</span>
  {% if show_icon %}
    <span class="pack-cta__icon pack-cta__icon--{{ icon_preset }}" aria-hidden="true">
      {% if icon_image != blank %}
        {{ icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
      {% elsif icon_preset == 'bag' %}
        <svg xmlns="http://www.w3.org/2000/svg" width="23" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M0 0h24v24H0V0z" fill="none"></path>
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm-1.45-5c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.37-.66-.11-1.48-.87-1.48H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.44C4.52 15.37 5.48 17 7 17h12v-2H7l1.1-2h7.45z"></path>
        </svg>
      {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" width="23" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M0 0h24v24H0V0z" fill="none"></path>
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm-1.45-5c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.37-.66-.11-1.48-.87-1.48H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.44C4.52 15.37 5.48 17 7 17h12v-2H7l1.1-2h7.45z"></path>
        </svg>
      {% endif %}
    </span>
  {% endif %}
{% if is_link %}
  </a>
{% else %}
  </button>
{% endif %}
