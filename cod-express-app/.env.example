PORT=3000
SHOPIFY_SHOP_DOMAIN=tienda-dev-cuunda.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Dev Dashboard (recomendado): Client ID + Secret — el token se renueva solo cada 24h
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# App heredada (alternativa): token fijo shpat_
# SHOPIFY_ADMIN_API_TOKEN=

# Mismo valor que Client secret (para validar app proxy)
SHOPIFY_API_SECRET=

# Opcional: ID de la Shopify Function quantity-discount (si ya fue desplegada)
# DISCOUNT_FUNCTION_ID=gid://shopify/ShopifyFunction/...
DISCOUNT_FUNCTION_HANDLE=quantity-discount
DISCOUNT_FUNCTION_TITLE=Descuento por cantidad

# Solo para desarrollo local sin firma de app proxy
ALLOW_UNSIGNED_PROXY=false
